{
  "manifest_version": 3,
  "name": "Lychee-Chat",
  "version": "0.2.5",
  "description": "在浏览器右上角与视觉模型聊天，每一轮自动附带当前页面截图。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "打开 Lychee-Chat",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lychee-chat@lycheeledger.cn",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications",
          "authenticationInfo"
        ]
      }
    }
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.moonshot.cn/*",
    "https://api.moonshot.ai/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://api.xiaomimimo.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://api.minimax.io/*",
    "https://api.minimaxi.com/*",
    "https://api.siliconflow.cn/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat.html",
        "chat.css",
        "chat.js",
        "lychee.css",
        "markdown.js",
        "model-context.js",
        "provider-icons.js",
        "theme.js",
        "themes.css",
        "assets/icon-32.png",
        "assets/icon-48.png",
        "assets/icon-128.png",
        "assets/providers/claude.png",
        "assets/providers/deepseek.png",
        "assets/providers/demo.png",
        "assets/providers/doubao.png",
        "assets/providers/gemini.png",
        "assets/providers/grok.png",
        "assets/providers/lmstudio.png",
        "assets/providers/mimo.png",
        "assets/providers/minimax.png",
        "assets/providers/moonshot.png",
        "assets/providers/ollama.png",
        "assets/providers/openai.png",
        "assets/providers/openrouter.png",
        "assets/providers/qwen.png",
        "assets/providers/siliconflow.png",
        "assets/providers/zhipu.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
